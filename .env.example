# Variables d'environnement VOLTRIX
# Copier en .env puis renseigner.
#
# ⚠️ Sécurité : ces valeurs sont SERVEUR uniquement. Ne jamais les
# préfixer par NEXT_PUBLIC_ — une variable NEXT_PUBLIC_ est injectée
# dans le bundle navigateur et deviendrait publique.

# Base PostgreSQL Neon des pronostics pré-calculés (architecture n°6).
# URL POOLER (pgbouncer) : requêtes runtime — API routes / Vercel.
DATABASE_URL="postgresql://<utilisateur>:<motdepasse>@<hote-pooler>.neon.tech/neondb?sslmode=require"

# URL DIRECTE (sans pooler) : migrations / prisma db push / DDL.
DIRECT_DATABASE_URL="postgresql://<utilisateur>:<motdepasse>@<hote-direct>.neon.tech/neondb?sslmode=require"

# Relai ESPN même-origine optionnel (défaut : appel direct à ESPN
# depuis le navigateur). Renseigner uniquement sur un réseau verrouillé.
# NEXT_PUBLIC_ESPN_SITE_BASE=""
# NEXT_PUBLIC_ESPN_CORE_BASE=""
